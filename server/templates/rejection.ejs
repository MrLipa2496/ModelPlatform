<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8" />
    <link
      href="https://fonts.googleapis.com/css2?family=Roboto+Slab:wght@400;600;700;900&display=swap"
      rel="stylesheet"
    />
    <style>
      :root {
        --black: #1a1a1a;
        --danger: #dc3545;
        --text-light: #555;
        --border-light: #e0e0e0;
      }
      body {
        font-family: 'Roboto Slab', serif;
        margin: 0;
        padding: 0;
        color: var(--black);
      }
      .document {
        width: 100%;
        max-width: 800px;
        margin: 0 auto;
        padding: 40px;
      }

      .header {
        border-bottom: 2px solid var(--black);
        padding-bottom: 20px;
        margin-bottom: 30px;
      }
      .logo {
        max-height: 60px;
      }
      .headerLogo {
        font-size: 35px;
        font-weight: 900;
        color: var(--black);
      }

      .mainTitle {
        font-size: 1.8rem;
        text-align: center;
        text-transform: uppercase;
        border-bottom: 1px solid var(--danger);
        padding-bottom: 15px;
        margin-bottom: 20px;
      }

      .dateLine {
        text-align: right;
        color: var(--text-light);
        font-size: 0.9rem;
        margin-bottom: 30px;
      }
      .subTitle {
        font-size: 1.2rem;
        margin-bottom: 15px;
        font-weight: 700;
      }

      .bodyText {
        line-height: 1.8;
        color: var(--text-light);
        margin-bottom: 20px;
        text-align: justify;
      }

      .reasonBox {
        background-color: #fff0f1; /* Легкий червоний фон */
        border-left: 4px solid var(--danger);
        padding: 15px;
        margin-bottom: 20px;
        font-style: italic;
        color: var(--black);
      }

      .footer {
        text-align: center;
        border-top: 2px solid var(--black);
        padding-top: 20px;
        margin-top: 50px;
        font-size: 0.8rem;
        color: var(--text-light);
      }
    </style>
  </head>
  <body>
    <div class="document">
      <header class="header">
        <% if (formatted.agencyLogo) { %>
        <img src="<%= formatted.agencyLogo %>" class="logo" />
        <% } else { %>
        <div class="headerLogo"><%= formatted.agencyName %></div>
        <% } %>
      </header>

      <h2 class="mainTitle">Application Status Update</h2>
      <div class="dateLine"><%= formatted.date %></div>

      <h3 class="subTitle">Dear <%= model.MOD_FirstName %>,</h3>

      <p class="bodyText">
        Thank you for your interest in the project
        <strong>"<%= casting.CST_Title %>"</strong> and for taking the time to
        submit your application.
      </p>

      <div class="reasonBox">
        <p><%= rejectionReason %></p>
      </div>

      <p class="bodyText">
        Please note that this decision is specific to this particular project.
        We have added your profile to our database and will review it for future
        opportunities that may be a better fit.
      </p>

      <p class="bodyText">
        We wish you the best of luck with your future endeavors.
      </p>

      <footer class="footer">
        <p>
          This is an official notification from <%= formatted.agencyName %>.
        </p>
      </footer>
    </div>
  </body>
</html>
